    "col_rectangle_shift": "((1-p)*(1-q)*(g_hat+delta_f)+p*(1-q*mu_payoff)+(1-p)*q*tau_2-JC)-((1-p)*(1-q)*g_hat+p*(1-q*mu_payoff)-JC)-((1-p)*(1-q)*delta_f+(1-p)*q*tau_2)",
    "row_envelope_positive_denominator": "xi*(1-gamma+gamma*(1-xi)/xi)-(xi*(1-gamma)+gamma*(1-xi))",
    "col_envelope_positive_denominator": "eta*(1-alpha+alpha*(1-eta)/eta)-(eta*(1-alpha)+alpha*(1-eta))"
  },
  "delta_f_free_ideal_aliases": {
    "Vr": "Min(1,(1-eta-r)/eta)",
    "Vc": "Min(1,(1-xi-r)/xi)",
    "kappa_1": "Max(0,(g_hat-sigma*Vc)/rho)",
    "kappa_2": "Max(0,(g_hat-rho*Vr)/sigma)",
    "h_1": "1-kappa_1",
    "h_2": "1-kappa_2",
    "s_1": "Min(1,1-lambda_payoff-(r-(1-eta)*(1-mu_payoff))/eta)",
    "s_2": "Min(1,1-mu_payoff-(r-(1-xi)*(1-lambda_payoff))/xi)",
    "S": "Min(1,h_1-(r-(1-eta)*s_2)/eta)",
    "T": "Min(1,h_2-(r-(1-xi)*s_1)/xi)",
    "row_D": "1-gamma+gamma*(1-xi)/xi",
    "row_ER": "((1-gamma)*S+gamma*(1-r/xi+(1-xi)*s_1/xi)-r)/row_D",
    "row_EC": "(gamma-(1-gamma)*h_2)/row_D",
    "row_test": "alpha*row_ER+(1-alpha)*row_EC-r",
    "col_D": "1-alpha+alpha*(1-eta)/eta",
    "col_CR": "(alpha-(1-alpha)*h_1)/col_D",
    "col_CC": "((1-alpha)*T+alpha*(1-r/eta+(1-eta)*s_2/eta)-r)/col_D",
    "col_test": "(1-gamma)*col_CR+gamma*col_CC-r"
  },
  "guarded_rules": [
